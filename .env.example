# Local development: leave VITE_API_BASE empty to use the Vite /api proxy.
VITE_API_BASE=
# Backend origin (without /api). Match the URL printed when the backend starts.
API_PROXY_TARGET=http://localhost:5000

# Google Maps API Key (optional):
# Leave empty to use OpenStreetMap. Provide a key to enable official Google Maps Platform.
VITE_GOOGLE_MAPS_API_KEY=
