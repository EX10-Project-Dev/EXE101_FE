# Backend API URL (Production: https://exe101-be-wkc0.onrender.com/api | Local: http://localhost:5128/api)
VITE_API_BASE=https://exe101-be-wkc0.onrender.com/api
# Login path relative to VITE_API_BASE, defaults to /v1/auth/login.
# Expected JSON: { accessToken: string, user: { userId, fullName, email } }
VITE_AUTH_LOGIN_PATH=/v1/auth/login
# Backend origin (without /api). Production: https://exe101-be-wkc0.onrender.com
API_PROXY_TARGET=https://exe101-be-wkc0.onrender.com

# Google Maps API Key (optional):
# Leave empty to use OpenStreetMap. Provide a key to enable official Google Maps Platform.
VITE_GOOGLE_MAPS_API_KEY=

# Public Google OAuth Web client ID. Never add GOOGLE_CLIENT_SECRET to Vite.
VITE_GOOGLE_CLIENT_ID=
# Google auth uses POST {VITE_API_BASE}/v1/auth/google with { idToken }.
